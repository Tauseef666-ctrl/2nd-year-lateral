# Normalise line endings for consistency across platforms
* text=auto eol=lf

# Source files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.svg text eol=lf

# Binaries (never touch)
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary

# GitHub handling
.github text eol=lf